# Copy this file to .env.local and fill in real values from your Supabase
# project (Dashboard → Settings → API). .env.local is gitignored — never
# commit real keys.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon" / "public" key — safe to expose in the browser, protected by the
# Row Level Security policies in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" secret key — used ONLY by scripts/migrate-properties.mjs,
# run locally by hand. Never used by the deployed app, never prefixed with
# NEXT_PUBLIC_, never committed. Do not add this to Vercel's env vars.
SUPABASE_SERVICE_ROLE_KEY=
